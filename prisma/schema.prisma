// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum SocialLinkType {
  X
  GITHUB
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  DISCORD
  TELEGRAM
  WHATSAPP
  WEBSITE
  EMAIL
}

model PortfolioItem {
  id String @id @default(uuid())

  title       String
  description String?
  url         String?
  images      Image[]

  user User @relation(fields: [userId], references: [id])

  userId String
}

model SocialLink {
  id     String         @id @default(uuid())
  type   SocialLinkType
  url    String
  user   User           @relation(fields: [userId], references: [id])
  userId String
}

model User {
  id String @id @default(uuid())

  username      String  @unique
  email         String  @unique
  password      String
  isVerified    Boolean @default(false)
  avatar        String?
  banner        String?
  headline      String?
  bio           String?
  firstName     String
  lastName      String
  isKycVerified Boolean @default(false)
  publicKey     String?

  verificationToken VerificationToken?
  gigs              Gig[]              @relation("Seller")
  bookmarked        Gig[]              @relation("Bookmarked")
  reviews           Review[]
  skills            UserSkill[]
  buyerChats        Chat[]             @relation("BuyerChat")
  sellerChats       Chat[]             @relation("SellerChat")

  badgeProgress  UserBadgeProgress[]
  ordersAsBuyer  Order[]             @relation("Buyer")
  ordersAsSeller Order[]             @relation("Seller")
  notifications  Notification[]
  socialLinks    SocialLink[]
  portfolioItems PortfolioItem[]

  messages     UserMessage[]
  readMessages Message[]     @relation("MessageReadBy")
}

model UserMessage {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  textMessageId    String? @unique
  fileMessageId    String? @unique
  imageMessageId   String? @unique
  linkMessageId    String? @unique
  paymentMessageId String? @unique

  textMessage  TextContent?
  mediaContent MediaContent?
  MediaFile    MediaFile[]
}

enum OrderStatus {
  WAITING_FOR_PAYMENT
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Order {
  id String @id @default(uuid())

  deadline DateTime
  status   OrderStatus @default(PENDING)

  package Package @relation(fields: [packageId], references: [id])
  review  Review?
  chat    Chat?
  buyer   User    @relation(name: "Buyer", fields: [buyerId], references: [id])
  seller  User    @relation(name: "Seller", fields: [sellerId], references: [id])

  packageId String
  buyerId   String
  sellerId  String

  createdAt DateTime @default(now())
  gig       Gig      @relation(fields: [gigId], references: [id])
  gigId     String
}

model Transaction {
  id String @id @default(uuid())
}

enum NotificationType {
  ORDER_UPDATE
  MESSAGE
  PAYMENT
  SYSTEM
  REVIEW
}

model Notification {
  id String @id @default(uuid())

  type        NotificationType
  title       String
  description String
  isRead      Boolean          @default(false)

  recipient User @relation(fields: [recipientId], references: [id])

  recipientId String

  createdAt DateTime @default(now())
}

model VerificationToken {
  id String @id @default(uuid())

  code      String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

  userId String @unique
}

model Gig {
  id String @id @default(uuid())

  title       String
  description String

  images    Image[]
  packages  Package[]
  seller    User         @relation(name: "Seller", fields: [sellerId], references: [id])
  bookmarks User[]       @relation("Bookmarked")
  category  Category     @relation(fields: [categoryId], references: [id])
  tags      Tag[]
  features  GigFeature[]
  reviews   Review[]
  faqs      GigFaq[]
  orders    Order[]

  categoryId String
  sellerId   String
}

model Image {
  id String @id @default(uuid())

  url       String
  isPrimary Boolean @default(false)

  gig           Gig?           @relation(fields: [gigId], references: [id])
  portfolioItem PortfolioItem? @relation(fields: [portfolioItemId], references: [id])

  gigId           String?
  portfolioItemId String?
}

model Package {
  id String @id @default(uuid())

  title        String
  price        Float
  revisions    Int
  deliveryTime Int

  gig      Gig              @relation(fields: [gigId], references: [id])
  features PackageFeature[]
  orders   Order[]

  gigId String
}

model GigFeature {
  id String @id @default(uuid())

  label String

  gig             Gig              @relation(fields: [gigId], references: [id])
  packageFeatures PackageFeature[]

  gigId String
}

model PackageFeature {
  id String @id @default(uuid())

  isIncluded Boolean

  gigPackage Package    @relation(fields: [gigPackageId], references: [id])
  feature    GigFeature @relation(fields: [featureId], references: [id])

  gigPackageId String
  featureId    String
}

model Tag {
  id String @id @default(uuid())

  label String
  slug  String @unique

  gigs Gig[]
}

model Category {
  id String @id @default(uuid())

  label String
  slug  String @unique
  depth Int    @default(0)

  gigs     Gig[]
  children Category[] @relation("CategoryParent")
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])

  parentId String?
}

model Review {
  id String @id @default(uuid())

  rating      Int
  title       String
  description String

  author User  @relation(fields: [authorId], references: [id])
  order  Order @relation(fields: [orderId], references: [id])
  gig    Gig   @relation(fields: [gigId], references: [id])

  orderId  String @unique
  authorId String
  gigId    String

  createdAt DateTime @default(now())
}

model Skill {
  id String @id @default(uuid())

  label String

  userSkills UserSkill[]
}

model UserSkill {
  id String @id @default(uuid())

  level Int @default(0)

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  userId  String
  skillId String

  @@unique([userId, skillId])
}

model Chat {
  id       String    @id @default(uuid())
  buyer    User      @relation(name: "BuyerChat", fields: [buyerId], references: [id])
  seller   User      @relation(name: "SellerChat", fields: [sellerId], references: [id])
  messages Message[]
  sellerId String
  buyerId  String
  orderId  String?   @unique
  order    Order?    @relation(fields: [orderId], references: [id])
}

enum MessageType {
  TEXT
  MEDIA
  SYSTEM
}

model Message {
  id     String      @id @default(uuid())
  type   MessageType
  readBy User[]      @relation("MessageReadBy")
  chat   Chat        @relation(fields: [chatId], references: [id])

  chatId    String
  createdAt DateTime @default(now())

  textContent   TextContent?
  mediaContent  MediaContent?
  systemContent SystemContent?
}

model TextContent {
  id   String @id @default(uuid())
  text String

  messageId     String      @unique
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userMessage   UserMessage @relation(fields: [userMessageId], references: [id])
  userMessageId String      @unique
}

model MediaContent {
  id String @id @default(uuid())

  urls MediaUrl[]

  messageId     String      @unique
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userMessage   UserMessage @relation(fields: [userMessageId], references: [id])
  userMessageId String      @unique
}

model MediaUrl {
  id  String @id @default(uuid())
  url String

  mediaContent   MediaContent @relation(fields: [mediaContentId], references: [id])
  mediaContentId String
}

model MediaFile {
  id String @id @default(uuid())

  url      String
  fileType String // e.g., "image/png", "video/mp4", etc.

  userMessage   UserMessage @relation(fields: [userMessageId], references: [id])
  userMessageId String
}

enum SystemContentType {
  WELCOME
}

model SystemContent {
  id        String            @id @default(uuid())
  content   String
  type      SystemContentType
  messageId String            @unique
  message   Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Badge {
  id String @id @default(uuid())

  title       String
  description String // A description of what the badge represents
  condition   String // Different badge calculation types eg. "consecutive response time under 5 minutes", "5-star reviews", etc.

  userBadges UserBadgeProgress[]
  milestones BadgeMilestone[]
}

enum Tier {
  NONE
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model BadgeMilestone {
  id String @id @default(uuid())

  threshold Int // e.g., 10, 25, 50, 100, 200

  tier  Tier // The tier awarded at this threshold
  badge Badge @relation(fields: [badgeId], references: [id])

  badgeId String
}

model UserBadgeProgress {
  id String @id @default(uuid())

  isFeatured Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  userId  String
  badgeId String

  currentProgress Int  @default(0) // Current count (resets for consecutive badges)
  highestTier     Tier @default(NONE) // Highest tier achieved (never decreases)

  @@unique([userId, badgeId]) // Each user can have only one progress record per badge
}

model GigFaq {
  id String @id @default(uuid())

  question String
  answer   String

  gig Gig @relation(fields: [gigId], references: [id])

  gigId String
}
