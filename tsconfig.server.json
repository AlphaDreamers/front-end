{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": false,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/server.ts"],
  "exclude": [
    "src/app/**/*",
    "src/components/**/*",
    "src/lib/actions/email.ts",
    "src/lib/actions/gigs.ts",
    "src/lib/actions/review.ts",
    "src/lib/store/**/*",
    "src/lib/utils.tsx",
    "node_modules"
  ]
}
